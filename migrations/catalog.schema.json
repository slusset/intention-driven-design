{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/slusset/intention-driven-design/migrations/catalog.schema.json",
  "title": "IDD Migration Catalog",
  "description": "Migration metadata shipped with the IDD Toolkit. Doctor reports cataloged paths; doctor apply executes accepted plans, with transform steps bound to registered deterministic transformations.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "migrations"],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schemaVersion": { "const": 1 },
    "migrations": {
      "type": "array",
      "items": { "$ref": "#/$defs/migration" }
    }
  },
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from", "to", "kind", "summary", "steps", "continuity"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "from": { "$ref": "#/$defs/target" },
        "to": { "$ref": "#/$defs/target" },
        "kind": { "const": "schema" },
        "summary": { "type": "string", "minLength": 1 },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/step" }
        },
        "continuity": { "$ref": "#/$defs/continuity" }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema"],
      "properties": {
        "schema": { "$ref": "#/$defs/version" },
        "toolkit": { "$ref": "#/$defs/version" }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "mode", "description"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "mode": { "enum": ["inspect", "review", "transform", "validate"] },
        "description": { "type": "string", "minLength": 1 },
        "transformation": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
      },
      "if": { "properties": { "mode": { "const": "transform" } } },
      "then": { "required": ["transformation"] },
      "else": { "not": { "required": ["transformation"] } }
    },
    "continuity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "intent", "semantics", "data", "operations"],
      "properties": {
        "identity": { "$ref": "#/$defs/disposition" },
        "intent": { "$ref": "#/$defs/disposition" },
        "semantics": { "$ref": "#/$defs/disposition" },
        "data": { "$ref": "#/$defs/disposition" },
        "operations": { "$ref": "#/$defs/disposition" }
      }
    },
    "disposition": {
      "enum": ["preserved", "transformed", "retired", "unchanged", "review-required", "unassessed"]
    }
  }
}
