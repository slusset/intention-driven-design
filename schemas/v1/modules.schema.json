{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/slusset/intention-driven-design/schemas/v1/modules.schema.json",
  "title": "IDD Modules Manifest",
  "description": "Assigns each capability chain to one module and declares the module dependency DAG.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "modules"],
  "properties": {
    "version": {
      "const": 1
    },
    "modules": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/module"
      }
    }
  },
  "$defs": {
    "repoRelativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capabilities", "rule_families", "depends_on"],
      "properties": {
        "root": {
          "$ref": "#/$defs/repoRelativePath",
          "default": "specs"
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "allOf": [
              { "$ref": "#/$defs/repoRelativePath" },
              { "pattern": "\\.capability\\.ya?ml$" }
            ]
          }
        },
        "rule_families": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*$"
          }
        },
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          }
        }
      }
    }
  }
}
