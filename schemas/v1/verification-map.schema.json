{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/slusset/intention-driven-design/schemas/v1/verification-map.schema.json",
  "title": "IDD Verification Map",
  "description": "Connects one capability to its rule inventory, evidence plan, dependency maps, and four independent maturity claims. Formal evidence kinds (alloy, tla, vectors, mutation probes, tooling) are canonical from v1.13.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "capability", "status", "rules"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*-verification$" },
    "type": { "const": "verification" },
    "capability": { "$ref": "#/$defs/capabilityPath" },
    "status": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "depends_on": {
      "type": "array",
      "uniqueItems": true,
      "default": [],
      "items": { "$ref": "#/$defs/verificationPath" }
    },
    "contract_pins": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "https://github.com/slusset/intention-driven-design/schemas/v1/contract-pin.schema.json"
      }
    },
    "strategy": { "$ref": "#/$defs/extensionObject" },
    "tooling": {
      "description": "Formal tooling the map's probes run under (v1.13). One entry per tool (alloy, tla, …); each names its sources and may pin the checker through a formal-tools lock.",
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/toolingEntry" }
    },
    "contracts": { "$ref": "#/$defs/extensionObject" },
    "journey_maps": { "$ref": "#/$defs/pathList" },
    "rules": { "type": "array", "minItems": 0, "items": { "$ref": "#/$defs/rule" } },
    "evidence_plan": {
      "description": "Evidence expected or still planned. A nested classification is accepted for migration but evidence.classification is canonical.",
      "allOf": [
        { "$ref": "#/$defs/extensionObject" },
        {
          "properties": {
            "classification": {
              "$ref": "https://github.com/slusset/intention-driven-design/schemas/v1/evidence-classification.schema.json"
            }
          }
        }
      ]
    },
    "evidence": {
      "description": "Current evidence description and the canonical four-claims classification.",
      "allOf": [
        { "$ref": "#/$defs/extensionObject" },
        {
          "properties": {
            "classification": {
              "$ref": "https://github.com/slusset/intention-driven-design/schemas/v1/evidence-classification.schema.json"
            }
          }
        }
      ]
    }
  },
  "oneOf": [
    {
      "required": ["evidence"],
      "properties": {
        "evidence": { "required": ["classification"] }
      }
    },
    {
      "required": ["evidence_plan"],
      "properties": {
        "evidence_plan": { "required": ["classification"] }
      }
    }
  ],
  "$defs": {
    "repoRelativePath": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$" },
    "capabilityPath": {
      "allOf": [
        { "$ref": "#/$defs/repoRelativePath" },
        { "pattern": "\\.capability\\.ya?ml$" }
      ]
    },
    "verificationPath": {
      "allOf": [
        { "$ref": "#/$defs/repoRelativePath" },
        { "pattern": "/verification/[^/]+/verification\\.ya?ml$" }
      ]
    },
    "ruleId": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*-[0-9]+(?:-[a-z0-9]+(?:-[a-z0-9]+)*)?$" },
    "pathList": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/repoRelativePath" } },
    "extensionObject": { "type": "object", "additionalProperties": true },
    "rule": {
      "type": "object",
      "required": ["id", "source_models"],
      "properties": {
        "id": { "$ref": "#/$defs/ruleId" },
        "source_models": {
          "description": "Models governing the rule. An explicit empty list records that no source model currently exists.",
          "$ref": "#/$defs/pathList"
        },
        "inherits": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/ruleId" } },
        "formal": {
          "description": "Narrative formal status for rules without executable probes (e.g. `status: deferred`). Author-extensible.",
          "$ref": "#/$defs/extensionObject"
        },
        "alloy": { "$ref": "#/$defs/alloyProbe" },
        "tla": { "$ref": "#/$defs/tlaProbe" },
        "conformance_vectors": {
          "description": "Vectors replayed against an implementation; each vector's `_meta.rules` must name this rule (reciprocity).",
          "$ref": "#/$defs/vectorList"
        },
        "mutation_probes": {
          "description": "Deliberate defects that the evidence must detect; each names what was mutated and the evidence that caught it.",
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/mutationProbe" }
        },
        "planned_evidence": { "$ref": "#/$defs/extensionObject" },
        "current_evidence": { "$ref": "#/$defs/evidencePayload" },
        "evidence": { "$ref": "#/$defs/evidencePayload" }
      },
      "additionalProperties": true,
      "patternProperties": { "^[a-z][a-z0-9]*_vectors$": { "$ref": "#/$defs/vectorList" } }
    },
    "evidencePayload": {
      "allOf": [
        { "$ref": "#/$defs/extensionObject" },
        {
          "properties": {
            "bindings": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "https://github.com/slusset/intention-driven-design/schemas/v1/evidence-binding.schema.json"
              }
            }
          }
        }
      ]
    },
    "toolingEntry": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "checker": { "type": "string" },
        "version": { "type": "string" },
        "jar": { "type": "string" },
        "sources": { "$ref": "#/$defs/pathList" },
        "configurations": { "type": "array", "items": { "type": "string" } },
        "scopes": { "type": "object", "additionalProperties": { "type": "string" } },
        "limitation": { "type": "string" },
        "lock": {
          "description": "Repo-relative formal-tools lock file (JSON) whose entry for this tool pins version, url, and sha256 of the checker.",
          "$ref": "#/$defs/repoRelativePath"
        }
      }
    },
    "alloyOutcome": { "enum": ["SAT", "UNSAT"] },
    "alloyProbeRef": {
      "description": "An Alloy command by name, or by name with its pinned outcome. `expected` is one outcome, or a map from profile path to outcome when profiles disagree (an intentional counterexample in the open model, closed in the hardened one).",
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "expected": {
              "oneOf": [
                { "$ref": "#/$defs/alloyOutcome" },
                {
                  "type": "object",
                  "minProperties": 1,
                  "additionalProperties": { "$ref": "#/$defs/alloyOutcome" }
                }
              ]
            },
            "note": { "type": "string" }
          }
        }
      ]
    },
    "alloyProbe": {
      "description": "Alloy evidence for a rule. `assertions` are `check` commands (UNSAT means no counterexample in scope); `predicates` are `run` commands (SAT means the scenario is representable). Every name must be declared in one of the map's alloy sources or the rule's profiles.",
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "assertions": { "type": "array", "items": { "$ref": "#/$defs/alloyProbeRef" } },
        "predicates": { "type": "array", "items": { "$ref": "#/$defs/alloyProbeRef" } },
        "inherited_assertions": { "type": "array", "items": { "$ref": "#/$defs/alloyProbeRef" } },
        "profiles": { "$ref": "#/$defs/pathList" },
        "abstraction": { "type": "string" },
        "status": {
          "description": "Narrative status when this tool does not apply to the rule (deferred, not-applicable-…, holds-by-construction-…).",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "tlaProbeRef": {
      "description": "A TLA+ invariant or property by name, or with its pinned outcome (`holds` by default; `violated` pins an intentional counterexample).",
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "expected": { "enum": ["holds", "violated"] },
            "note": { "type": "string" }
          }
        }
      ]
    },
    "tlaProbe": {
      "description": "TLA+ evidence for a rule. Invariants and properties must be declared in the model (`Name ==`) or its configuration (INVARIANT / PROPERTY).",
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "model": { "$ref": "#/$defs/repoRelativePath" },
        "inherited_model": { "$ref": "#/$defs/repoRelativePath" },
        "invariants": { "type": "array", "items": { "$ref": "#/$defs/tlaProbeRef" } },
        "properties": { "type": "array", "items": { "$ref": "#/$defs/tlaProbeRef" } },
        "preserved_invariants": { "type": "array", "items": { "$ref": "#/$defs/tlaProbeRef" } },
        "status": {
          "description": "Narrative status when this tool does not apply to the rule (deferred, not-applicable-…, holds-by-construction-…).",
          "type": "string",
          "minLength": 1
        },
        "note": { "type": "string" }
      }
    },
    "vectorList": {
      "description": "Vector fixture paths (files or directories), as a list or a single path.",
      "oneOf": [
        { "$ref": "#/$defs/repoRelativePath" },
        { "$ref": "#/$defs/pathList" }
      ]
    },
    "mutationProbe": {
      "type": "object",
      "additionalProperties": true,
      "required": ["mutation", "detected_by"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "mutation": { "description": "What was deliberately broken.", "type": "string", "minLength": 1 },
        "detected_by": {
          "description": "Evidence that failed as a result: test files, vectors, or a probe name.",
          "$ref": "#/$defs/pathList"
        },
        "expected": { "const": "detected", "default": "detected" },
        "note": { "type": "string" }
      }
    }
  }
}
